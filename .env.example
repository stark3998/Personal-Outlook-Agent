# Outlook / provider
OUTLOOK_AGENT_PROVIDER=applescript
OUTLOOK_AGENT_APPLESCRIPT_TIMEOUT=30
OUTLOOK_AGENT_APPLESCRIPT_LARGE_TIMEOUT=120

# Storage: approval/audit persistence (memory | sqlite). Use sqlite to share the gated
# action flow across CLI and API processes and to survive restarts.
OUTLOOK_AGENT_APPROVAL_STORE=memory
OUTLOOK_AGENT_DATABASE_URL=sqlite:///outlook_agent.db

# API
OUTLOOK_AGENT_API_HOST=127.0.0.1
OUTLOOK_AGENT_API_PORT=8765

# Logging
OUTLOOK_AGENT_LOG_LEVEL=INFO
OUTLOOK_AGENT_LOG_JSON=true

# Live tests (opt-in, read-only). NEVER enable send/delete in automated tests.
OUTLOOK_LIVE_TESTS=false

# Microsoft Foundry / Azure OpenAI (via the Microsoft Agent Framework OpenAIChatClient; do NOT commit real values)
FOUNDRY_ENDPOINT=
FOUNDRY_DEPLOYMENT=
FOUNDRY_API_VERSION=
# Credential — one is required when Foundry is enabled (prefer an API key locally).
FOUNDRY_API_KEY=
FOUNDRY_ACCESS_TOKEN=
